    m_MaxSize: 40
    m_Alignment: 0
    m_AlignByGeometry: 0
    m_RichText: 1
    m_HorizontalOverflow: 0
    m_VerticalOverflow: 1
    m_LineSpacing: 1
  m_Text: "\u25C6 \uC7A5\uB974 : \uD134\uC81C RPG\n\u25C6 \uBC30\uACBD : \uB9C8\uC744\uC744
    \uC704\uD611\uD558\uB294 \uC5B4\uB450\uC6B4 \uB358\uC804\n\n\uC6A9\uC0AC\uAC00
    \uB418\uC5B4 \uB358\uC804 \uAE4A\uC740 \uACF3\uC758 \uBAAC\uC2A4\uD130\uB4E4\uC744
    \uBB3C\uB9AC\uCE58\uC138\uC694.\n\uCD1D 3\uAC1C\uC758 \uC2A4\uD14C\uC774\uC9C0\uAC00
    \uC788\uACE0, \uAC01 \uC2A4\uD14C\uC774\uC9C0\uC758 \uB05D\uC5D0\uB294 \uBCF4\uC2A4\uAC00
    \uAE30\uB2E4\uB9BD\uB2C8\uB2E4.\n\uBCF4\uC2A4\uB97C \uC4F0\uB7EC\uB728\uB9AC\uBA74
    \uB2E4\uC74C \uC2A4\uD14C\uC774\uC9C0\uB85C \uB118\uC5B4\uAC11\uB2C8\uB2E4.\n\n\u25C6
    \uC131\uC7A5 : \uBAAC\uC2A4\uD130\uB97C \uC7A1\uC73C\uBA74 \uACBD\uD5D8\uCE58\uC640
    \uACE8\uB4DC\uB97C \uC5BB\uC2B5\uB2C8\uB2E4.\n         \uB808\uBCA8\uC774 \uC624\uB974\uBA74
    \uCCB4\uB825\xB7\uB9C8\uB098\xB7\uACF5\uACA9\uB825\uC774 \uC624\uB974\uACE0 \uC0C8
    \uC2A4\uD0AC\uC744 \uBC30\uC6C1\uB2C8\uB2E4.\n\u25C6 \uC0C1\uC810 : \uACE8\uB4DC\uB85C
    \uC7A5\uBE44, \uC2A4\uD0AC\uBD81, \uD68C\uBCF5 \uC544\uC774\uD15C\uC744 \uC0B4
    \uC218 \uC788\uC2B5\uB2C8\uB2E4.\n\u25C6 \uBAA9\uD45C : 3\uC2A4\uD14C\uC774\uC9C0
    \uBCF4\uC2A4\uB97C \uCC98\uCE58\uD558\uC5EC \uB358\uC804\uC744 \uC815\uD654\uD558\uC138\uC694!"
