--- !u!114 &1457193558
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1457193556}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5f7201a12d95ffc409449d95f23cf332, type: 3}
  m_Name: 
  m_EditorClassIdentifier: UnityEngine.UI::UnityEngine.UI.Text
  m_Material: {fileID: 0}
  m_Color: {r: 0.95, g: 0.91, b: 0.83, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_FontData:
    m_Font: {fileID: 12800000, guid: 70ed646cfaab7e54db97b6b11d9bb7e4, type: 3}
    m_FontSize: 24
    m_FontStyle: 0
    m_BestFit: 0
    m_MinSize: 10
    m_MaxSize: 40
    m_Alignment: 0
    m_AlignByGeometry: 0
    m_RichText: 1
    m_HorizontalOverflow: 0
    m_VerticalOverflow: 1
    m_LineSpacing: 1
  m_Text: "\u25A0 \uC9C0\uB3C4 \uD654\uBA74\n   \uAE38\uC774 \uC774\uC5B4\uC9C4 \uBC29\uB9CC
    \uAC08 \uC218 \uC788\uC2B5\uB2C8\uB2E4. \uB178\uB780 \u25B6 \uD45C\uC2DC\uAC00
    \uC9C0\uAE08 \uAC08 \uC218 \uC788\uB294 \uBC29\uC785\uB2C8\uB2E4.\n   \uC804\uD22C
    \uBC29 \u2192 \uC0C1\uC810 \uBC29 \u2192 \uBCF4\uC2A4 \uBC29 \uC21C\uC11C\uB85C
    \uC9C4\uD589\uB429\uB2C8\uB2E4.\n\n\u25A0 \uC804\uD22C (\uD134\uC81C)\n   \uC18D\uB3C4\uAC00
    \uBE60\uB978 \uC21C\uC11C\uB300\uB85C \uD55C \uBA85\uC529 \uD589\uB3D9\uD569\uB2C8\uB2E4.\n  
    [\uACF5\uACA9] \uAE30\uBCF8 \uACF5\uACA9     [\uC2A4\uD0AC] MP\uB97C \uC368\uC11C
    \uAC15\uD55C \uAE30\uC220     [\uC544\uC774\uD15C] \uD3EC\uC158 \uC0AC\uC6A9\n  
    \uC801\uC774 '\uBC29\uC5B4'\uB97C \uC900\uBE44\uD558\uBA74 \uD654\uBA74\uC5D0
    \U0001F6E1 \uD45C\uC2DC\uAC00 \uBBF8\uB9AC \uB739\uB2C8\uB2E4. \uAE09\uC2B5 \uC2A4\uD0AC\uB85C
    \uAE70 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\n   \uBCF4\uC2A4\uC758 \u26A0 \uD45C\uC2DC\uB294
    \uC544\uC8FC \uAC15\uD55C \uAE30\uC220\uC744 \uC900\uBE44 \uC911\uC774\uB77C\uB294
    \uB73B\uC785\uB2C8\uB2E4.\n\n\u25A0 \uC0C1\uC810 \uBC0F \uD734\uC2DD\n   \uACE8\uB4DC\uB85C
    \uC7A5\uBE44\xB7\uC2A4\uD0AC\uBD81\xB7\uC544\uC774\uD15C\uC744 \uC0AC\uACE0,
    \uD734\uC2DD\uC73C\uB85C \uCCB4\uB825\uC744 30% \uD68C\uBCF5\uD569\uB2C8\uB2E4.\n  
    \uC0B0 \uBB3C\uAC74\uC740 \uBC30\uB0AD(4\uCE78)\uC73C\uB85C \uB4E4\uC5B4\uAC11\uB2C8\uB2E4.
    \uBC30\uB0AD\uC774 \uAF49 \uCC28\uBA74 \uC0B4 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4.\n\n\u25A0
    \uC870\uC791 : \uB9C8\uC6B0\uC2A4 \uD074\uB9AD / ESC \uC77C\uC2DC\uC815\uC9C0
    / F1~F10 \uCE58\uD2B8\uD0A4"
